<UserControl x:Class="PcStatsMonitor.Controls.RgbDisplayScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PcStatsMonitor.Controls"
             Width="480" Height="854"
             Background="Transparent"
             FontFamily="{Binding Theme.FontFamily, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='Segoe UI'}">

    <!-- Top margin clears the BYLD logo above this screen so the title isn't crowded. -->
    <Grid Margin="26,170,26,70">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: title + accent underline -->
        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,26">
            <TextBlock Text="RGB LIGHTING"
                       Foreground="{Binding Theme.ForegroundColor, FallbackValue='#FFFFFF'}"
                       FontSize="26" FontWeight="Heavy" HorizontalAlignment="Center"/>
            <Border Height="3" Width="54" CornerRadius="2" Margin="0,8,0,0"
                    Background="{Binding Theme.AccentColorBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Rgb.VisibleDevices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Glassmorphic device card -->
                        <Border Background="#0CFFFFFF"
                                BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="14"
                                Margin="0,0,0,12" Padding="16,14,18,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Device badge: a lamp/bulb glyph that reads clearly as lighting
                                         control, lit in the zone's live colour. The plain dot did not
                                         signify RGB (client round 19, item 3). -->
                                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" Margin="0,0,16,0"
                                            Background="#14FFFFFF" VerticalAlignment="Center">
                                        <Grid Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Colour wheel: six spectrum segments around a hub.
                                                 Reads immediately as colour/lighting control. -->
                                            <Ellipse Width="34" Height="34">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#EF4444" Offset="0.00"/>
                                                        <GradientStop Color="#F59E0B" Offset="0.20"/>
                                                        <GradientStop Color="#FDE047" Offset="0.35"/>
                                                        <GradientStop Color="#22C55E" Offset="0.52"/>
                                                        <GradientStop Color="#06B6D4" Offset="0.68"/>
                                                        <GradientStop Color="#6366F1" Offset="0.84"/>
                                                        <GradientStop Color="#D946EF" Offset="1.00"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <!-- Second sweep at right angles, so the wheel reads as
                                                 a full spectrum rather than a single diagonal ramp -->
                                            <Ellipse Width="34" Height="34" Opacity="0.55">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                                                        <GradientStop Color="#00000000" Offset="0.0"/>
                                                        <GradientStop Color="#8822C55E" Offset="0.35"/>
                                                        <GradientStop Color="#00000000" Offset="0.7"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <!-- Hub tinted with the device's live colour -->
                                            <Ellipse Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="{Binding Zones[0].SelectedColor, FallbackValue=#3B82F6}"/>
                                                </Ellipse.Fill>
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="{Binding Zones[0].SelectedColor, FallbackValue=#3B82F6}" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <!-- Thin dark ring separating hub from wheel -->
                                            <Ellipse Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Stroke="#66000000" StrokeThickness="2"/>
                                        </Grid>
                                    </Border>

                                    <!-- Name + type -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding DataContext.Theme.ForegroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='#FFFFFF'}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Type}" Foreground="{Binding DataContext.Theme.ForegroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='#FFFFFF'}" Opacity="0.45" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Active mode chip -->
                                    <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="9" Padding="10,4"
                                            Background="#1F3B82F6">
                                        <TextBlock Text="{Binding SelectedMode}" Foreground="{Binding DataContext.Theme.AccentColorBrush, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <!-- Zone colour chips -->
                                <ItemsControl ItemsSource="{Binding Zones}" Margin="68,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="8,3" Margin="0,0,8,6" Background="#0FFFFFFF">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Ellipse.Fill>
                                                            <SolidColorBrush Color="{Binding SelectedColor}"/>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <TextBlock Foreground="{Binding DataContext.Theme.ForegroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='#FFFFFF'}" Opacity="0.6" FontSize="11" VerticalAlignment="Center">
                                                        <Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding LedCount, StringFormat='{}{0} LEDs', Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- No devices fallback -->
        <TextBlock Grid.Row="1" Text="No RGB devices detected.&#x0a;OpenRGB server required for live data."
                   Foreground="{Binding Theme.ForegroundColor, FallbackValue='#FFFFFF'}" Opacity="0.3"
                   FontSize="14" FontWeight="SemiBold" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Rgb.Devices.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
