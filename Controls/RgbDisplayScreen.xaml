<UserControl x:Class="PcStatsMonitor.Controls.RgbDisplayScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PcStatsMonitor.Controls"
             Width="480" Height="854"
             Background="Transparent"
             FontFamily="{Binding Theme.FontFamily, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='Segoe UI'}">

    <!-- Top margin clears the BYLD logo above this screen so the title isn't crowded. -->
    <Grid Margin="26,170,26,70">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: title + accent underline -->
        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,26">
            <TextBlock Text="RGB LIGHTING"
                       Foreground="{Binding Theme.ForegroundColor, FallbackValue='#FFFFFF'}"
                       FontSize="26" FontWeight="Heavy" HorizontalAlignment="Center"/>
            <Border Height="3" Width="54" CornerRadius="2" Margin="0,8,0,0"
                    Background="{Binding Theme.AccentColorBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Rgb.VisibleDevices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Glassmorphic device card -->
                        <Border Background="#0CFFFFFF"
                                BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="14"
                                Margin="0,0,0,12" Padding="16,14,18,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Device badge: a lamp/bulb glyph that reads clearly as lighting
                                         control, lit in the zone's live colour. The plain dot did not
                                         signify RGB (client round 19, item 3). -->
                                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" Margin="0,0,16,0"
                                            Background="#14FFFFFF" VerticalAlignment="Center">
                                        <Grid Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Modern spectrum RING: six true colour arcs forming a
                                                 ring, with a clean solid core in the device's live
                                                 colour. Flat, geometric and legible at a glance
                                                 (client round 20, item 3). -->
                                            <Grid Width="36" Height="36">
                                                <!-- Each arc is a stroked pie segment of the ring -->
                                                <Path Stroke="#EF4444" StrokeThickness="6" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                                                      Data="M 18,3 A 15,15 0 0 1 30.99,10.5"/>
                                                <Path Stroke="#F59E0B" StrokeThickness="6" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                                                      Data="M 30.99,10.5 A 15,15 0 0 1 30.99,25.5"/>
                                                <Path Stroke="#22C55E" StrokeThickness="6" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                                                      Data="M 30.99,25.5 A 15,15 0 0 1 18,33"/>
                                                <Path Stroke="#06B6D4" StrokeThickness="6" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                                                      Data="M 18,33 A 15,15 0 0 1 5.01,25.5"/>
                                                <Path Stroke="#6366F1" StrokeThickness="6" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                                                      Data="M 5.01,25.5 A 15,15 0 0 1 5.01,10.5"/>
                                                <Path Stroke="#D946EF" StrokeThickness="6" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                                                      Data="M 5.01,10.5 A 15,15 0 0 1 18,3"/>
                                            </Grid>
                                            <!-- Solid core in the device's current colour -->
                                            <Ellipse Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="{Binding Zones[0].SelectedColor, FallbackValue=#3B82F6}"/>
                                                </Ellipse.Fill>
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="{Binding Zones[0].SelectedColor, FallbackValue=#3B82F6}" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </Grid>
                                    </Border>

                                    <!-- Name + type. Sizes raised across this card: at arm's length
                                         on a 7" panel the old 11pt secondary text was unreadable
                                         (client round 20, item 4). -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding DataContext.Theme.ForegroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='#FFFFFF'}" FontSize="21" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Type}" Foreground="{Binding DataContext.Theme.ForegroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='#FFFFFF'}" Opacity="0.6" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Active effect, on its own full-width row so the name above has
                                     the space it needs and the mode is readable at a glance. -->
                                <Border CornerRadius="10" Padding="12,7" Margin="68,12,0,0" HorizontalAlignment="Left"
                                        Background="#1F3B82F6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="EFFECT" Opacity="0.55" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{Binding DataContext.Theme.ForegroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='#FFFFFF'}"/>
                                        <TextBlock Text="{Binding SelectedMode}" Margin="10,0,0,0" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{Binding DataContext.Theme.AccentColorBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Zone rows: a large colour swatch, the zone name, and its LED
                                     count on the right. One per line instead of small wrapped
                                     chips, so each is easy to read and scan. -->
                                <ItemsControl ItemsSource="{Binding Zones}" Margin="68,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12" Padding="12,9" Margin="0,0,0,8" Background="#12FFFFFF">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Live colour swatch, glowing in its own colour -->
                                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding SelectedColor}"/>
                                                        </Border.Background>
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="{Binding SelectedColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/>
                                                        </Border.Effect>
                                                    </Border>

                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                               FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               Foreground="{Binding DataContext.Theme.ForegroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='#FFFFFF'}"/>

                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Opacity="0.55"
                                                               Text="{Binding LedCount, StringFormat='{}{0} LEDs', Mode=OneWay}"
                                                               Foreground="{Binding DataContext.Theme.ForegroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='#FFFFFF'}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- No devices fallback -->
        <TextBlock Grid.Row="1" Text="No RGB devices detected.&#x0a;OpenRGB server required for live data."
                   Foreground="{Binding Theme.ForegroundColor, FallbackValue='#FFFFFF'}" Opacity="0.3"
                   FontSize="14" FontWeight="SemiBold" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Rgb.Devices.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
