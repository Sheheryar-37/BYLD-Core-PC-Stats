<UserControl x:Class="PcStatsMonitor.Controls.RgbDisplayScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PcStatsMonitor.Controls"
             Width="480" Height="854"
             Background="Transparent"
             FontFamily="{Binding Theme.FontFamily, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='Segoe UI'}">
    
    <Grid Margin="30,80,30,80">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="RGB DEVICES" Foreground="{Binding Theme.ForegroundColor, FallbackValue='#FFFFFF'}" FontSize="28" FontWeight="Heavy" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Rgb.Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{Binding DataContext.Theme.TrackColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='#1A1A1A'}" BorderThickness="0,0,0,1" Margin="0,5,0,5" Padding="0,15,0,15">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- RGB Icon Animation -->
                                    <Path Grid.Column="0" Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" 
                                          Fill="{Binding DataContext.Theme.AccentColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='#3B82F6'}" 
                                          Width="30" Height="30" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" Margin="0,0,15,0" Opacity="0.8">
                                    </Path>

                                    <!-- Device Name + Type -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding DataContext.Theme.ForegroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='#FFFFFF'}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Type}" Foreground="{Binding DataContext.Theme.ForegroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='#FFFFFF'}" Opacity="0.4" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Active Mode -->
                                <TextBlock Text="{Binding SelectedMode, StringFormat='Mode: {0}'}" Foreground="{Binding DataContext.Theme.AccentColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='#3B82F6'}" FontSize="13" FontWeight="SemiBold" Margin="45,6,0,0"/>
                                
                                <!-- Zones list -->
                                <ItemsControl ItemsSource="{Binding Zones}" Margin="45,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{Binding SelectedColor}"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Foreground="{Binding DataContext.Theme.ForegroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='#FFFFFF'}" Opacity="0.6" FontSize="12">
                                                    <Run Text="{Binding Name, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding LedCount, StringFormat='{}{0} LEDs', Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- No devices fallback -->
        <TextBlock Grid.Row="1" Text="No RGB devices detected.&#x0a;OpenRGB server required for live data." 
                   Foreground="{Binding Theme.ForegroundColor, FallbackValue='#FFFFFF'}" Opacity="0.3" 
                   FontSize="14" FontWeight="SemiBold" TextAlignment="Center" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Rgb.Devices.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
