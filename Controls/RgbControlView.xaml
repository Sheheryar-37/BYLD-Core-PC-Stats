<UserControl x:Class="PcStatsMonitor.Controls.RgbControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="500">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- Retinted by SettingsWindow.ApplyUiTheme() in light mode -->
        <SolidColorBrush x:Key="WarnText" Color="#FFB0B0"/>
        <SolidColorBrush x:Key="RgbCardBg" Color="#0C0C1A"/>
        <SolidColorBrush x:Key="RgbCardBorder" Color="#1A1A35"/>
        <SolidColorBrush x:Key="RgbCardText" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="RgbDimText" Color="#94A3B8"/>
        <SolidColorBrush x:Key="RgbInputBg" Color="#1A1A2E"/>
        <SolidColorBrush x:Key="RgbInputBorder" Color="#2A2A4A"/>

        <!-- ═══ 7" visibility toggle ═══
             Matches the sleek toggle used on the fan cards; a stock CheckBox did not fit the
             app's look (client round 19, item 6). -->
        <Style x:Key="WidgetToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="8" Background="#2A2A4A">
                            <Ellipse x:Name="Dot" Fill="#94A3B8" Width="12" Height="12" Margin="2,0,0,0" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3B82F6"/>
                                <Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Dot" Property="Margin" Value="0,0,2,0"/>
                                <Setter TargetName="Dot" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Nudge button (reorder on the 7" display) ═══
             Custom-templated to match the card surface; a bare Button with Style="{x:Null}"
             rendered as flat default chrome (client round 18 follow-up). -->
        <Style x:Key="RgbNudgeButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource RgbCardText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{DynamicResource RgbInputBg}"
                                BorderBrush="{DynamicResource RgbInputBorder}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333B82F6"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#553B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Dark ComboBox Toggle ═══ -->
        <ControlTemplate x:Key="DarkComboToggle" TargetType="ToggleButton">
            <Border x:Name="Border" CornerRadius="6" Background="{DynamicResource RgbInputBg}" BorderBrush="{DynamicResource RgbInputBorder}" BorderThickness="1" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#6B7280"
                          Data="M 0 0 L 5 5 L 10 0 Z"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <!-- Hover feedback is the blue border only — a hardcoded dark hover
                     background made the dropdown unreadable in light mode. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ═══ Dark ComboBox Style ═══ -->
        <Style x:Key="RgbComboStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource RgbCardText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource DarkComboToggle}" 
                                          Focusable="False" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter Name="ContentSite" Margin="12,6,32,6" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" IsHitTestVisible="False"
                                              TextElement.Foreground="{DynamicResource RgbCardText}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Grid SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{DynamicResource RgbInputBg}" BorderThickness="1" BorderBrush="{DynamicResource RgbInputBorder}" CornerRadius="6" Margin="0,2,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
                                        </Border.Effect>
                                    </Border>
                                    <Border Background="{DynamicResource RgbInputBg}" CornerRadius="6" Margin="0,2,0,0">
                                        <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Dark ComboBoxItem Style ═══ -->
        <Style x:Key="RgbComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource RgbCardText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="4" Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <!-- Solid BrandBlue + white works on both the light and dark popup -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- ═══ Color Swatch Button ═══ -->
        <Style x:Key="ColorSwatchButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SwatchBorder" CornerRadius="5" BorderThickness="2" BorderBrush="#33FFFFFF" 
                                Width="48" Height="26" SnapsToDevicePixels="True">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding SelectedColor}"/>
                            </Border.Background>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="SwatchBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#3B82F6" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Master Color Swatch Button (Apply to All) ═══ -->
        <Style x:Key="MasterSwatchButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SwatchBorder" CornerRadius="5" BorderThickness="2" BorderBrush="#33FFFFFF"
                                Width="48" Height="26" SnapsToDevicePixels="True">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding MasterColor}"/>
                            </Border.Background>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="SwatchBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#3B82F6" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Loading indicator -->
        <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" 
                    HorizontalAlignment="Center" Margin="0,20">
            <TextBlock Text="Connecting to OpenRGB..." Foreground="#64748B" FontStyle="Italic" FontSize="12"/>
        </StackPanel>

        <!-- OpenRGB Admin Warning -->
        <Border Background="#22E63946" BorderBrush="#E63946" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,15"
                Visibility="{Binding ShowAdminWarning, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel>
                <TextBlock Text="⚠ OpenRGB Access Denied" Foreground="#E63946" FontWeight="Bold" FontSize="12"/>
                <TextBlock Text="Some RGB devices (like your GPU or generic case fans) require OpenRGB to be running as an Administrator to be detected. BYLD Core will attempt to restart OpenRGB with Admin privileges automatically."
                           Foreground="{DynamicResource WarnText}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══ Apply to All Devices ═══ -->
        <Border Background="{DynamicResource RgbCardBg}" BorderBrush="{DynamicResource RgbCardBorder}" BorderThickness="1" CornerRadius="10"
                Padding="18" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="APPLY TO ALL DEVICES" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Shared lighting effect (modes every device supports) -->
                    <ComboBox Grid.Column="0" ItemsSource="{Binding CommonModes}" SelectedItem="{Binding SelectedCommonMode}"
                              Style="{StaticResource RgbComboStyle}" ItemContainerStyle="{StaticResource RgbComboItemStyle}"
                              ToolTip="Applies this lighting effect to every device that supports it"/>
                    <!-- Shared colour swatch — opens ColorPickerWindow -->
                    <Button Grid.Column="2" Style="{StaticResource MasterSwatchButton}" VerticalAlignment="Center"
                            Command="{Binding ApplyAllColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ToolTip="Click to apply one color or gradient to all devices"/>
                </Grid>
                <!-- Undo apply-to-all: restores each device's own mode + colors -->
                <Button Content="↩ Restore per-device settings" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Padding="10,4" FontSize="10" Cursor="Hand"
                        Foreground="{DynamicResource RgbDimText}" Background="#14FFFFFF" BorderBrush="{DynamicResource RgbInputBorder}" BorderThickness="1"
                        Command="{Binding RestoreAllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        IsEnabled="{Binding CanRestoreDevices}"
                        ToolTip="Undo 'apply to all' — every device goes back to the mode and colors it had before">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#22FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══ Connected: Device Cards ═══ -->
        <ItemsControl ItemsSource="{Binding OrderedDevices}">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource RgbCardBg}" BorderBrush="{DynamicResource RgbCardBorder}" BorderThickness="1" CornerRadius="10"
                            Padding="18" Margin="0,0,0,12">
                        <!-- Dimmed when hidden from the 7" display, matching the fan cards. The
                             device stays fully controllable here. -->
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowOnWidget}" Value="False">
                                        <Setter Property="Opacity" Value="0.55"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <!-- Device Header -->
                            <DockPanel Margin="0,0,0,14">
                                <!-- 7" display controls: show/hide + reorder (round 18, items 9 & 13) -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="7&quot; DISPLAY" Foreground="#64748B" FontSize="9" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ToggleButton IsChecked="{Binding ShowOnWidget, Mode=OneWay}" Click="ChkRgbShowOnWidget_Click"
                                                  Style="{StaticResource WidgetToggleStyle}"
                                                  VerticalAlignment="Center" Margin="0,0,10,0"
                                                  ToolTip="Show this device on the 7&quot; display"/>
                                    <Button Content="▲" Click="BtnRgbMoveUp_Click" Style="{StaticResource RgbNudgeButton}"
                                            ToolTip="Move earlier on the 7&quot; display"/>
                                    <Button Content="▼" Click="BtnRgbMoveDown_Click" Style="{StaticResource RgbNudgeButton}"
                                            ToolTip="Move later on the 7&quot; display"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                <!-- RGB spectrum icon -->
                                <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#EF4444" Offset="0"/>
                                            <GradientStop Color="#10B981" Offset="0.5"/>
                                            <GradientStop Color="#3B82F6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <!-- LED chip / light-ray icon -->
                                    <Path Data="M12,2 L15,9 L22,9 L16.5,13.5 L18.5,21 L12,16.5 L5.5,21 L7.5,13.5 L2,9 L9,9 Z"
                                          Fill="White" Opacity="0.9" Width="14" Height="14" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource RgbCardText}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding Type, StringFormat='({0})'}" Foreground="#64748B" FontSize="11" Margin="0,1,0,0"/>
                                </StackPanel>
                                </StackPanel>
                            </DockPanel>

                            <!-- Separator -->
                            <Border Height="1" Background="{DynamicResource RgbCardBorder}" Margin="0,0,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Lighting Effect -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="LIGHTING EFFECT" Foreground="#64748B" FontSize="10" FontWeight="Bold" 
                                               Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" 
                                              Style="{StaticResource RgbComboStyle}" ItemContainerStyle="{StaticResource RgbComboItemStyle}"/>
                                </StackPanel>

                                <!-- Right: Zones & Color Swatches -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ZONES &amp; COLORS" Foreground="#64748B" FontSize="10" FontWeight="Bold" 
                                               Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding Zones}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource RgbCardText}" FontSize="12" 
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding LedCount, StringFormat='{}{0} LEDs'}" 
                                                                   Foreground="#475569" FontSize="9" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <!-- Clickable color swatch — opens ColorPickerWindow -->
                                                    <Button Grid.Column="1" Style="{StaticResource ColorSwatchButton}" 
                                                            Command="{Binding ChangeColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}" ToolTip="Click to change zone color"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        
        <!-- ═══ Not Connected Fallback ═══ -->
        <Border CornerRadius="10" Background="{DynamicResource RgbCardBg}" BorderBrush="{DynamicResource RgbCardBorder}" BorderThickness="1" Padding="20" Margin="0,5,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="⚡" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="RGB Not Connected" Foreground="{DynamicResource RgbDimText}" FontSize="13" FontWeight="SemiBold" 
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="To enable RGB control:" 
                           Foreground="#475569" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Left" 
                           HorizontalAlignment="Left" Margin="0,0,0,4"/>
                <TextBlock Text="1. Download and install OpenRGB from openrgb.org&#x0a;2. Open OpenRGB and go to the 'SDK Server' tab&#x0a;3. Click 'Start Server' (or check 'Autostart Server' in Settings)&#x0a;4. Click Connect below" 
                           Foreground="#475569" FontSize="11" TextWrapping="Wrap" TextAlignment="Left" 
                           HorizontalAlignment="Left" Margin="0,0,0,12"/>
                <Button Content="Connect to OpenRGB" Command="{Binding ConnectCommand}"
                        Width="140" Height="30" Cursor="Hand" FontSize="11" FontWeight="SemiBold"
                        Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <!-- Solid BrandBlue reads correctly on both themes -->
                            <Border x:Name="Bg" CornerRadius="6" Background="#2563EB" BorderBrush="#2563EB" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#3B82F6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
