<UserControl x:Class="PcStatsMonitor.Controls.FanControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="700">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Color x:Key="BrandBlueColor">#3b82f6</Color>
        <SolidColorBrush x:Key="BrandBlue" Color="{StaticResource BrandBlueColor}"/>
        <SolidColorBrush x:Key="CardBg" Color="#0AFFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource BrandBlueColor}"/>
        <SolidColorBrush x:Key="DimText" Color="#88FFFFFF"/>
        <!-- Page-level brushes — retinted by SettingsWindow.ApplyUiTheme() in light mode.
             Card interiors keep white-on-navy in every theme (matches the Fan Control reference). -->
        <SolidColorBrush x:Key="PageText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PageDimText" Color="#88FFFFFF"/>
        <SolidColorBrush x:Key="WarnText" Color="#FFB0B0"/>
        <SolidColorBrush x:Key="CardText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardFill" Color="#11FFFFFF"/>
        <SolidColorBrush x:Key="CardStroke" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="FanPopupBg" Color="#1E1E2E"/>

        <!-- Tiny +/- Button -->
        <Style x:Key="TinyBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#05FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inline editable TextBox for fan params -->
        <Style x:Key="InlineEditBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource CardText}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrandBlue}"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BrandBlue}"/>
                    <Setter Property="Background" Value="#0CFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Toggle Switch -->
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="8" Background="#333333">
                            <Ellipse x:Name="Dot" Fill="White" Width="12" Height="12" Margin="2,0,0,0" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Dot" Property="Margin" Value="0,0,2,0"/>
                                <Setter TargetName="Dot" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Curve Type Toggle (Linear/Custom) -->
        <Style x:Key="CurveTypeToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="4" Background="{DynamicResource CardFill}" Padding="6,3" BorderThickness="1" BorderBrush="{DynamicResource CardStroke}">
                            <TextBlock x:Name="Lbl" Text="Linear" FontSize="9" Foreground="{DynamicResource DimText}" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#223b82f6"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrandBlue}"/>
                                <Setter TargetName="Lbl" Property="Text" Value="Custom"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="{StaticResource BrandBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FAB Add Button -->
        <Style x:Key="FabBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0,0,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="20" Background="{StaticResource AccentBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.4" Color="{StaticResource BrandBlueColor}"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Delete Button Style -->
        <Style x:Key="DeleteBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="3" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33E63946"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fan icon path data -->
        <Geometry x:Key="FanIconGeom">M12 12c0-3 2.5-5.5 5.5-5.5S23 9 23 12c0 1.4-.5 2.6-1.4 3.6L12 12zm0 0c3 0 5.5 2.5 5.5 5.5S15 23 12 23c-1.4 0-2.6-.5-3.6-1.4L12 12zm0 0c0 3-2.5 5.5-5.5 5.5S1 15 1 12c0-1.4.5-2.6 1.4-3.6L12 12zm0 0c-3 0-5.5-2.5-5.5-5.5S9 1 12 1c1.4 0 2.6.5 3.6 1.4L12 12z</Geometry>
        
        <!-- Glass ComboBox Toggle -->
        <ControlTemplate x:Key="GlassComboBoxToggle" TargetType="ToggleButton">
            <Border x:Name="Border" CornerRadius="6" Background="{DynamicResource CardFill}" BorderThickness="1" BorderBrush="{DynamicResource CardStroke}">
                <Path x:Name="Arrow" Fill="{DynamicResource DimText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
            </Border>
            <ControlTemplate.Triggers>
                <!-- Hover feedback via blue border only — hardcoded fills/whites broke light mode -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrandBlue}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource BrandBlue}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrandBlue}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Glass ComboBox Style -->
        <Style x:Key="GlassComboStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource CardText}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource GlassComboBoxToggle}" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter Margin="8,4,24,4" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                              TextElement.Foreground="{DynamicResource CardText}"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Grid SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{DynamicResource FanPopupBg}" BorderThickness="1" BorderBrush="#33FFFFFF" CornerRadius="4" Margin="0,2,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                                        </Border.Effect>
                                    </Border>
                                    <Border Background="{DynamicResource FanPopupBg}" CornerRadius="4" Margin="0,2,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Loading -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center" Margin="0,20">
                    <TextBlock Text="Scanning Hardware..." Foreground="#64748B" FontStyle="Italic" FontSize="12"/>
                </StackPanel>

                <!-- Detection Warning (context-sensitive) -->
                <Border Background="#22E63946" BorderBrush="#E63946" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,15"
                        Visibility="{Binding ShowHvciWarning, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                    <StackPanel>
                        <TextBlock Text="⚠ Fan Detection Issue" Foreground="#E63946" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Foreground="{DynamicResource WarnText}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="{Binding DetectionStatusMessage}"/>
                    </StackPanel>
                </Border>

                <!-- CONTROLS HEADER -->
                <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                    <TextBlock Text="Controls" Foreground="{DynamicResource PageText}" FontWeight="Bold" FontSize="14"/>
                    <Border CornerRadius="9" BorderBrush="{DynamicResource PageDimText}" BorderThickness="1" Width="18" Height="18" Margin="8,0"
                            Cursor="Help" Background="Transparent"
                            ToolTipService.InitialShowDelay="100" ToolTipService.ShowDuration="30000">
                        <Border.ToolTip>
                            <ToolTip Padding="0" Background="Transparent" BorderThickness="0" HasDropShadow="False">
                                <Border Background="#F2141420" BorderBrush="#3A3A55" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <TextBlock MaxWidth="300" TextWrapping="Wrap" FontSize="11" Foreground="#F0F0F5"
                                               Text="Each card is one controllable fan. Toggle ON to follow a fan curve (choose it in the dropdown); toggle OFF to set a static speed — type an exact percentage or use the +/− buttons. Step up/down, Start/Stop %, Offset and Minimum % fine-tune how speed changes are applied."/>
                                </Border>
                            </ToolTip>
                        </Border.ToolTip>
                        <TextBlock Text="?" Foreground="{DynamicResource PageDimText}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- FANS CARDS -->
                <ItemsControl ItemsSource="{Binding Fans}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,12,12" Width="220">
                                <StackPanel>
                                    <!-- Header: icon + name + menu -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Data="{StaticResource FanIconGeom}" Fill="{StaticResource BrandBlue}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource CardText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2" Content="⋮" Foreground="{DynamicResource CardText}" FontWeight="Bold" FontSize="14" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0" Padding="4,0" Style="{x:Null}" Click="BtnContextMenu_Click">
                                            <Button.ContextMenu>
                                                <ContextMenu Background="{DynamicResource FanPopupBg}" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                    <MenuItem Header="Reset to Auto" Foreground="{DynamicResource CardText}" Click="FanContextReset_Click"/>
                                                    <MenuItem Header="Set Manual (50%)" Foreground="{DynamicResource CardText}" Click="FanContextManual_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>

                                    <!-- Mode label (Curve / Static) + toggle + curve dropdown -->
                                    <Grid Margin="40,0,0,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Curve" FontSize="9" Foreground="{StaticResource DimText}"
                                                   Visibility="{Binding IsAuto, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="Static (manual %)" FontSize="9" Foreground="{StaticResource DimText}"
                                                   Visibility="{Binding IsManual, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton IsChecked="{Binding IsAuto}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                      ToolTip="ON: follow the selected fan curve. OFF: static — type an exact speed percentage."/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableCurves}" SelectedItem="{Binding SelectedCurve}"
                                                  Style="{StaticResource GlassComboStyle}" Height="22" Cursor="Hand" VerticalAlignment="Center"
                                                  Visibility="{Binding IsAuto, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ComboBox.Resources>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1E1E2E"/>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3b82f6"/>
                                            </ComboBox.Resources>
                                        </ComboBox>
                                    </Grid>

                                    <!-- % and RPM -->
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="{Binding SpeedPercentage, StringFormat={}{0:F1} %}" Foreground="{DynamicResource CardText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Left"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding CurrentRpm, StringFormat={}{0} RPM}" Foreground="{DynamicResource CardText}" FontSize="13" FontWeight="Bold"/>
                                            <TextBlock Text=" ▼" Foreground="{StaticResource DimText}" FontSize="9" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- Static manual speed (visible in Manual mode) -->
                                    <StackPanel Visibility="{Binding IsManual, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,4">
                                        <TextBlock Text="Static speed" FontSize="9" Foreground="{StaticResource DimText}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding SpeedPercentage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineEditBox}" LostFocus="InlineEdit_LostFocus"/>
                                            <TextBlock Text=" %" Foreground="{StaticResource DimText}" FontSize="9" VerticalAlignment="Center"/>
                                            <Button Content="+" Foreground="{StaticResource AccentBrush}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnParamPlus_Click" Tag="SpeedPercentage"/>
                                            <Button Content="-" Foreground="{StaticResource DimText}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnParamMinus_Click" Tag="SpeedPercentage"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Zero-fan mode hint -->
                                    <TextBlock Text="GPU is in zero-fan mode (normal at low temps)"
                                               Foreground="{DynamicResource DimText}" FontSize="8" FontStyle="Italic" Margin="0,0,0,4"
                                               Visibility="{Binding IsZeroRpm, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>

                                    <Rectangle Height="1" Fill="{DynamicResource CardFill}" Margin="0,0,0,8"/>

                                    <!-- Params grid: 3 rows x 2 cols with editable TextBox + +/- -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Row 0: Step up / Step down -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,6">
                                            <TextBlock Text="Step up" FontSize="9" Foreground="{StaticResource DimText}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding StepUp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineEditBox}" LostFocus="InlineEdit_LostFocus"/>
                                                <TextBlock Text=" %/s" Foreground="{StaticResource DimText}" FontSize="9" VerticalAlignment="Center"/>
                                                <Button Content="+" Foreground="{StaticResource AccentBrush}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnParamPlus_Click" Tag="StepUp"/>
                                                <Button Content="-" Foreground="{StaticResource DimText}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnParamMinus_Click" Tag="StepUp"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,6">
                                            <TextBlock Text="Step down" FontSize="9" Foreground="{StaticResource DimText}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding StepDown, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineEditBox}" LostFocus="InlineEdit_LostFocus"/>
                                                <TextBlock Text=" %/s" Foreground="{StaticResource DimText}" FontSize="9" VerticalAlignment="Center"/>
                                                <Button Content="+" Foreground="{StaticResource AccentBrush}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnParamPlus_Click" Tag="StepDown"/>
                                                <Button Content="-" Foreground="{StaticResource DimText}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnParamMinus_Click" Tag="StepDown"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Row 1: Start % / Stop % -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,6">
                                            <TextBlock Text="Start %" FontSize="9" Foreground="{StaticResource DimText}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding StartPercentage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineEditBox}" LostFocus="InlineEdit_LostFocus"/>
                                                <TextBlock Text=" %" Foreground="{StaticResource DimText}" FontSize="9" VerticalAlignment="Center"/>
                                                <Button Content="+" Foreground="{StaticResource AccentBrush}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnParamPlus_Click" Tag="StartPercentage"/>
                                                <Button Content="-" Foreground="{StaticResource DimText}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnParamMinus_Click" Tag="StartPercentage"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,6">
                                            <TextBlock Text="Stop %" FontSize="9" Foreground="{StaticResource DimText}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding StopPercentage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineEditBox}" LostFocus="InlineEdit_LostFocus"/>
                                                <TextBlock Text=" %" Foreground="{StaticResource DimText}" FontSize="9" VerticalAlignment="Center"/>
                                                <Button Content="+" Foreground="{StaticResource AccentBrush}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnParamPlus_Click" Tag="StopPercentage"/>
                                                <Button Content="-" Foreground="{StaticResource DimText}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnParamMinus_Click" Tag="StopPercentage"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Row 2: Offset / Minimum -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Offset" FontSize="9" Foreground="{StaticResource DimText}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding Offset, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineEditBox}" LostFocus="InlineEdit_LostFocus"/>
                                                <TextBlock Text=" %" Foreground="{StaticResource DimText}" FontSize="9" VerticalAlignment="Center"/>
                                                <Button Content="+" Foreground="{StaticResource AccentBrush}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnParamPlus_Click" Tag="Offset"/>
                                                <Button Content="-" Foreground="{StaticResource DimText}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnParamMinus_Click" Tag="Offset"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Minimum %" FontSize="9" Foreground="{StaticResource DimText}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding MinimumPercentage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineEditBox}" LostFocus="InlineEdit_LostFocus"/>
                                                <TextBlock Text=" %" Foreground="{StaticResource DimText}" FontSize="9" VerticalAlignment="Center"/>
                                                <Button Content="+" Foreground="{StaticResource AccentBrush}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnParamPlus_Click" Tag="MinimumPercentage"/>
                                                <Button Content="-" Foreground="{StaticResource DimText}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnParamMinus_Click" Tag="MinimumPercentage"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- CURVES HEADER -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                    <TextBlock Text="Curves" Foreground="{DynamicResource PageText}" FontWeight="Bold" FontSize="14"/>
                    <Border CornerRadius="9" BorderBrush="{DynamicResource PageDimText}" BorderThickness="1" Width="18" Height="18" Margin="8,0"
                            Cursor="Help" Background="Transparent"
                            ToolTipService.InitialShowDelay="100" ToolTipService.ShowDuration="30000">
                        <Border.ToolTip>
                            <ToolTip Padding="0" Background="Transparent" BorderThickness="0" HasDropShadow="False">
                                <Border Background="#F2141420" BorderBrush="#3A3A55" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <TextBlock MaxWidth="300" TextWrapping="Wrap" FontSize="11" Foreground="#F0F0F5"
                                               Text="A curve maps a temperature to a fan speed: the fan ramps from Min speed at Min temp up to Max speed at Max temp, following the selected temperature source. Create curves with the + button, then assign one to a fan from the fan card's Curve dropdown."/>
                                </Border>
                            </ToolTip>
                        </Border.ToolTip>
                        <TextBlock Text="?" Foreground="{DynamicResource PageDimText}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- CURVE CARDS -->
                <ItemsControl ItemsSource="{Binding Curves}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,12,12" Width="220">
                                <StackPanel>
                                    <!-- Header with delete button -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Data="M 2 14 L 7 4 L 12 10 L 20 2" Stroke="White" StrokeThickness="2" Width="22" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource InlineEditBox}" TextAlignment="Left" Width="NaN" HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                                        <Button Grid.Column="2" Content="✕" Foreground="#E63946" Style="{StaticResource DeleteBtnStyle}" 
                                                Command="{Binding DataContext.DeleteCurveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" ToolTip="Delete this curve" Margin="0,0,4,0"/>
                                        <Button Grid.Column="3" Content="⋮" Foreground="{DynamicResource CardText}" FontWeight="Bold" FontSize="14" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0" Padding="4,0" Style="{x:Null}" Click="BtnContextMenu_Click">
                                            <Button.ContextMenu>
                                                <ContextMenu Background="{DynamicResource FanPopupBg}" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                    <MenuItem Header="Duplicate" Foreground="{DynamicResource CardText}" Click="CurveContextDuplicate_Click"/>
                                                    <MenuItem Header="Delete" Foreground="#E63946" Click="CurveContextDelete_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>

                                    <!-- Curve Type Toggle -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Type" FontSize="9" Foreground="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ToggleButton Style="{StaticResource CurveTypeToggle}" 
                                                      IsChecked="{Binding CurveType, Converter={StaticResource CurveTypeConverter}}"
                                                      ToolTip="Toggle between Linear and Custom curve modes"/>
                                    </StackPanel>

                                    <!-- Temp Source -->
                                    <TextBlock Text="Temperature source" FontSize="9" Foreground="{StaticResource DimText}" Margin="0,0,0,2"/>
                                    <Border BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1" Padding="2" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding TemperatureSource}" Foreground="{DynamicResource CardText}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                    </Border>

                                    <!-- RPM -->
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="{Binding CurrentRpm, StringFormat={}{0} RPM}" Foreground="{DynamicResource CardText}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left"/>
                                    </Grid>

                                    <!-- Details: Min/Max temp and speed (%) with editable TextBoxes -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Min. temp." FontSize="9" Foreground="{StaticResource DimText}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding MinTemp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineEditBox}" LostFocus="InlineEdit_LostFocus"/>
                                                <TextBlock Text=" °C" Foreground="{StaticResource DimText}" FontSize="9" VerticalAlignment="Center"/>
                                                <Button Content="+" Foreground="{StaticResource AccentBrush}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnCurveParamPlus_Click" Tag="MinTemp"/>
                                                <Button Content="-" Foreground="{StaticResource DimText}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnCurveParamMinus_Click" Tag="MinTemp"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Max. temp." FontSize="9" Foreground="{StaticResource DimText}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding MaxTemp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineEditBox}" LostFocus="InlineEdit_LostFocus"/>
                                                <TextBlock Text=" °C" Foreground="{StaticResource DimText}" FontSize="9" VerticalAlignment="Center"/>
                                                <Button Content="+" Foreground="{StaticResource AccentBrush}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnCurveParamPlus_Click" Tag="MaxTemp"/>
                                                <Button Content="-" Foreground="{StaticResource DimText}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnCurveParamMinus_Click" Tag="MaxTemp"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Min speed" FontSize="9" Foreground="{StaticResource DimText}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding MinSpeed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineEditBox}" LostFocus="InlineEdit_LostFocus"/>
                                                <TextBlock Text=" %" Foreground="{StaticResource DimText}" FontSize="9" VerticalAlignment="Center"/>
                                                <Button Content="+" Foreground="{StaticResource AccentBrush}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnCurveParamPlus_Click" Tag="MinSpeed"/>
                                                <Button Content="-" Foreground="{StaticResource DimText}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnCurveParamMinus_Click" Tag="MinSpeed"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Max speed" FontSize="9" Foreground="{StaticResource DimText}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding MaxSpeed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineEditBox}" LostFocus="InlineEdit_LostFocus"/>
                                                <TextBlock Text=" %" Foreground="{StaticResource DimText}" FontSize="9" VerticalAlignment="Center"/>
                                                <Button Content="+" Foreground="{StaticResource AccentBrush}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnCurveParamPlus_Click" Tag="MaxSpeed"/>
                                                <Button Content="-" Foreground="{StaticResource DimText}" Style="{StaticResource TinyBtnStyle}" Margin="2,0,0,0" Click="BtnCurveParamMinus_Click" Tag="MaxSpeed"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Hysteresis -->
                                    <TextBlock Text="Hysteresis" FontSize="9" Foreground="{StaticResource DimText}" Margin="0,0,0,2"/>
                                    <TextBlock Foreground="{DynamicResource CardText}" FontSize="10" Margin="0,0,0,8">
                                        <Run Text="↑"/><Run Text="{Binding HysteresisUp, StringFormat={}{0} °C, Mode=OneWay}"/>
                                        <Run Text="  ↓"/><Run Text="{Binding HysteresisDown, StringFormat={}{0} °C, Mode=OneWay}"/>
                                    </TextBlock>

                                    <!-- Fan curve graph — LIVE BINDING to GraphPoints -->
                                    <Border Background="#08FFFFFF" CornerRadius="4" Height="55" Margin="0,4,0,0" ClipToBounds="True">
                                        <Canvas>
                                            <!-- Baseline -->
                                            <Line X1="0" Y1="50" X2="190" Y2="50" Stroke="#15FFFFFF" StrokeThickness="1"/>
                                            <!-- Curve line — dynamically bound -->
                                            <Polyline Points="{Binding GraphPoints}" Stroke="{StaticResource BrandBlue}" StrokeThickness="2" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- FAB: Add Curve button (floating bottom-right) -->
        <Button Content="+" Foreground="#1A1A2E" Style="{StaticResource FabBtnStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16"
                Command="{Binding AddCurveCommand}" ToolTip="Add new fan curve"/>
    </Grid>
</UserControl>
