<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\byld-icon.ico</ApplicationIcon>
    <!-- Suppress NU1605: LHM pre-release has a lower transitive System.Management ref; our explicit pin wins -->
    <NoWarn>$(NoWarn);NU1605</NoWarn>
    <RollForward>Major</RollForward>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenRGB.NET" Version="3.1.1" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre686" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <PackageReference Include="TaskScheduler" Version="2.11.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Management" Version="10.0.7" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\**" />
    <None Update="theme.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory> 
    </None>
  
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="PcStatsMonitor.PluginApi\**" />
    <Compile Remove="Tools\**" />
    <EmbeddedResource Remove="PcStatsMonitor.PluginApi\**" />
    <EmbeddedResource Remove="Tools\**" />
    <None Remove="PcStatsMonitor.PluginApi\**" />
    <None Remove="Tools\**" />
    <Page Remove="PcStatsMonitor.PluginApi\**" />
    <Page Remove="Tools\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="PcStatsMonitor.PluginApi\PcStatsMonitor.PluginApi.csproj" />
  </ItemGroup>

  <!-- Bundle the PawnIO installer so the app can silently install the signed
       driver on first run (see Services/PawnIoDriverService.cs). Download the
       official PawnIO_setup.exe from https://pawnio.eu/ (repo: namazso/PawnIO.Setup)
       and place it at the repo root. The Condition keeps the build working when the
       binary is not present locally; ship a build only with it in place. -->
  <ItemGroup Condition="Exists('PawnIO_setup.exe')">
    <None Remove="PawnIO_setup.exe" />
    <Content Include="PawnIO_setup.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>
