<Window x:Class="PcStatsMonitor.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BYLD Core" Width="320" Height="260"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">
    <Window.Resources>
        <!-- Status text fade-in -->
        <Storyboard x:Key="StatusFadeIn">
            <DoubleAnimation Storyboard.TargetName="StatusText" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.5"/>
        </Storyboard>
    </Window.Resources>

    <!-- Dark glassmorphism card -->
    <Border CornerRadius="16" Background="#E0101020" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Logo -->
                <Grid HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Image Source="Assets/byld-icon.png" Width="56" Height="56"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>

                <!-- App name -->
                <TextBlock Text="BYLD CORE" Foreground="#E8E8F0" FontSize="18" FontWeight="Bold"
                           FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,6"
                           Opacity="0.95"/>

                <!-- Version text -->
                <TextBlock Text="Initializing..." Foreground="#64748B" FontSize="10"
                           FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Status text (dynamic) -->
                <TextBlock x:Name="StatusText" Text="Loading hardware sensors..." 
                           Foreground="#94A3B8" FontSize="11" FontStyle="Italic"
                           FontFamily="Segoe UI" HorizontalAlignment="Center" Opacity="0"/>

                <!-- Thin progress bar -->
                <Border Width="160" Height="3" CornerRadius="2" Background="#1A1A35" Margin="0,12,0,0">
                    <Border x:Name="ProgressBar" Width="0" Height="3" CornerRadius="2"
                            HorizontalAlignment="Left">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#3b82f6" Offset="0"/>
                                <GradientStop Color="#60a5fa" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
