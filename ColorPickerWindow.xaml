<Window x:Class="PcStatsMonitor.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Color" Height="720" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Modern Slider Thumb -->
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse Width="18" Height="18" Fill="#3b82f6" Effect="{x:Null}"/>
                            <Ellipse Width="10" Height="10" Fill="White"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Track background -->
                            <Border Height="4" CornerRadius="2" Background="#333333" VerticalAlignment="Center"/>
                            <!-- Track filled portion -->
                            <Canvas x:Name="TrackCanvas" Height="4" VerticalAlignment="Center" ClipToBounds="False">
                                <Border x:Name="FilledTrack" Height="4" CornerRadius="2" Background="#3b82f6" VerticalAlignment="Center"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Null}}"/>
                            </Canvas>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Height="22"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}" Cursor="Hand"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Height="22"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border Background="#D9111111" CornerRadius="15" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12" HorizontalAlignment="Center">
                <CheckBox x:Name="ChkGradient" Content="Enable Linear Gradient" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" 
                          Checked="ChkGradient_Changed" Unchecked="ChkGradient_Changed" Margin="0,0,0,8" Cursor="Hand"/>
                <StackPanel x:Name="PnlGradientTargets" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                    <RadioButton x:Name="RbStartColor" Content="START COLOR" IsChecked="True" Foreground="#3B82F6" FontSize="10" FontWeight="Bold" Margin="0,0,15,0" Checked="ColorTarget_Changed" Cursor="Hand"/>
                    <RadioButton x:Name="RbEndColor" Content="END COLOR" Foreground="#88FFFFFF" FontSize="10" FontWeight="Bold" Checked="ColorTarget_Changed" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
            <!-- ═══ HSB Colour Wheel ═══ -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,12"
                  MouseLeftButtonDown="ColorWheel_MouseDown" 
                  MouseMove="ColorWheel_MouseMove"
                  MouseLeftButtonUp="ColorWheel_MouseUp">
                <Canvas x:Name="ColorWheelCanvas" Width="260" Height="260" 
                        Cursor="Cross" ClipToBounds="True"/>
                <!-- Selector indicator on the wheel -->
                <Ellipse x:Name="WheelSelector" Width="12" Height="12" 
                         Stroke="White" StrokeThickness="2" Fill="Transparent"
                         IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="Black" Opacity="0.6"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Grid>

            <!-- Brightness slider -->
            <DockPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="Brightness:" Foreground="#AAA" Width="70" VerticalAlignment="Center" FontSize="11"/>
                <Slider x:Name="SldBrightness" Minimum="0" Maximum="100" Value="100" 
                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SldBrightness_ValueChanged"/>
            </DockPanel>

            <TextBlock Grid.Row="3" Text="Basic Colors" Foreground="#AAAAAA" Margin="0,0,0,5"/>
            <ItemsControl x:Name="ColorGrid" Grid.Row="4" Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="28" Height="28" Margin="2" Click="Color_Click" Tag="{Binding}" Background="{Binding}" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="SwBorder" Background="{TemplateBinding Background}" CornerRadius="5" 
                                            BorderBrush="#22FFFFFF" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SwBorder" Property="BorderBrush" Value="#3B82F6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="5" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="R:" Foreground="#AAA" Width="20" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtR" Width="35" DockPanel.Dock="Right" Background="#222" Foreground="#FFF" BorderThickness="0" TextAlignment="Center" TextChanged="Rgb_TextChanged"/>
                        <Slider x:Name="SldR" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Margin="5,0" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="G:" Foreground="#AAA" Width="20" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtG" Width="35" DockPanel.Dock="Right" Background="#222" Foreground="#FFF" BorderThickness="0" TextAlignment="Center" TextChanged="Rgb_TextChanged"/>
                        <Slider x:Name="SldG" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Margin="5,0" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="B:" Foreground="#AAA" Width="20" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtB" Width="35" DockPanel.Dock="Right" Background="#222" Foreground="#FFF" BorderThickness="0" TextAlignment="Center" TextChanged="Rgb_TextChanged"/>
                        <Slider x:Name="SldB" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Margin="5,0" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Hex:" Foreground="#AAA" Width="30" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtHex" Height="22" Background="#222" Foreground="#FFF" BorderThickness="0" Padding="5,2" TextChanged="TxtHex_TextChanged"/>
                    </DockPanel>
                </StackPanel>

                <Border Grid.Column="1" x:Name="PreviewBorder" CornerRadius="10" BorderBrush="#22FFFFFF" BorderThickness="1" Background="#FFFFFF">
                    <TextBlock x:Name="LblPreview" Text="Preview" Foreground="#88000000" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                </Border>
            </Grid>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="CANCEL" Click="Cancel_Click" Background="Transparent" Foreground="#88FFFFFF" BorderThickness="0" Margin="0,0,15,0" Cursor="Hand"/>
                <Button Content="SELECT" Click="Select_Click" Width="80" Height="30" Background="#3b82f6" Foreground="White" FontWeight="Bold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
